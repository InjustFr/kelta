  "check": [
    "sl",
    "--version"
  ],
  "close_on_exit": "never",
  "command": null,
  "cwd": null,
  "description": null,
  "embed": "auto",
  "enabled": true,
  "env": {},
  "icon": "branch",
  "id": "isl",
  "install_hint": "https://sapling-scm.com/docs/introduction/installation",
