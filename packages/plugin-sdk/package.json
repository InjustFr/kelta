{
  "name": "@kelta/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK for Kelta plugin screens (sandboxed iframes talking to the host over a MessageChannel).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --declaration",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
